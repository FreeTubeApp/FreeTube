# Copy this file to .env (next to compose.yaml) and adjust it.

# Address under which browsers reach Invidious. FreeTube uses it as its default instance,
# Invidious uses it for absolute URLs (e.g. thumbnails).
# Local test:
INVIDIOUS_PUBLIC_URL=http://localhost:3000
# Behind a reverse proxy with HTTPS:
# INVIDIOUS_PUBLIC_URL=https://invidious.example.com

# Ports on the host (default: 8080 and 3000)
# FREETUBE_PORT=8080
# INVIDIOUS_PORT=3000

# Optional: secret keys of Invidious. If empty, they are generated on the first start and stored in the volume.
# INVIDIOUS_HMAC_KEY=
# INVIDIOUS_COMPANION_KEY=

# How often Invidious gets restarted, as recommended by the Invidious documentation (default: 1h)
# INVIDIOUS_RESTART_INTERVAL=1h
